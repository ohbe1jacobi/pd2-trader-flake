# Local notes are private by default; keep the public entry-point documents.
*.md
!/README.md
!/LICENSE.md
!/CHANGELOG.md
!/AGENTS.md
!/CONTRIBUTING.md
!/SECURITY.md
!/.github/CODE_OF_CONDUCT.md
!/.github/pull_request_template.md
!/docs/installation.md
!/docs/flatpak.md
!/docs/flatpak-pages.md
!/docs/configuration.md
!/docs/troubleshooting.md
!/docs/maintaining.md
!/flatpak/README.md
!/flatpak/publishing.md

