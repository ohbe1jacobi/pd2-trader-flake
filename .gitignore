# Local notes are private by default; keep the public entry-point documents.
*.md
!/README.md
!/LICENSE.md
!/CHANGELOG.md
!/AGENTS.md

# Optional development checkout, historical packaging, and local diagnostics.
/upstream/
/legacy-appimage/
/diagnostics/
/private/

# Nix outputs and local development state. Keep flake.lock tracked.
/result
/result-*
.direnv/
.envrc.local
/.pre-commit-config.yaml

# Build outputs, test output, and downloaded release artifacts.
node_modules/
target/
dist/
build/
coverage/
htmlcov/
